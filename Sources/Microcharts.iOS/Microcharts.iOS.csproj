<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <IsTrimmable>true</IsTrimmable>
    <RootNamespace>Microcharts.iOS</RootNamespace>
    <AssemblyName>Microcharts.iOS</AssemblyName>
    <Description>Simple, cross-platform chart library for dotnet iOS.</Description>
    <PackageTags>maui ios chart</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Graphics" Version="10.0.20" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Microcharts/Microcharts.csproj" />
  </ItemGroup>
</Project>