<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Plugin.Maui.Microchart.Samples.ChartPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:charts="clr-namespace:Plugin.Maui.Microchart;assembly=Plugin.Maui.Microchart"
             xmlns:local="clr-namespace:Plugin.Maui.Microchart.Samples;assembly=Plugin.Maui.Microchart.Samples.Maui"
             x:DataType="local:ChartPage"
             x:Name="Page">
    <ContentPage.Content>
        <Grid Margin="10"
              RowDefinitions="Auto, Auto, *">
            <Label Margin="20,0,0,0"
                   FontSize="Title"
                   Text="{Binding ExampleChartItem.ExampleName, Source={x:Reference Page}}"
                   TextColor="Black" />
            <Label Grid.Row="1"
                   Margin="20,0,0,0"
                   FontSize="Subtitle"
                   LineBreakMode="WordWrap"
                   TextColor="Gray"
                   Text="{Binding ExampleChartItem.ExampleTextDescription, Source={x:Reference Page}}" />

            <charts:ChartView x:Name="chartView"
                                   Grid.Row="2"
                                   BackgroundColor="White"
                                   HeightRequest="250" />
        </Grid>
    </ContentPage.Content>
</ContentPage>
