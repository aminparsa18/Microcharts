<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>disable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <TrimMode Condition="'$(Configuration)' == 'Release'">full</TrimMode>
    <RootNamespace>Plugin.Maui.Microchart.Samples.iOS</RootNamespace>
    <IPhoneResourcePrefix>Resources</IPhoneResourcePrefix>
    <AssemblyName>Plugin.Maui.Microchart.Samples.iOS</AssemblyName>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <CodesignKey>iPhone Developer</CodesignKey>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Plugin.Maui.Microchart.iOS/Plugin.Maui.Microchart.iOS.csproj" />
    <ProjectReference Include="../Plugin.Maui.Microchart.Samples.Core/Plugin.Maui.Microchart.Samples.Core.csproj" />
    <ProjectReference Include="../../src/Plugin.Maui.Microchart.Core/Plugin.Maui.Microchart.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Properties/" />
  </ItemGroup>
</Project>
