<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <NuspecFile>Plugin.Maui.Microchart.Metapackage.nuspec</NuspecFile>
    <!-- Feed $version$ in the nuspec (package version + Plugin.Maui.Microchart.* deps) from the
         computed PackageVersion so the meta-package tracks the platform packages,
         both for CI builds (3.0.0.<run>) and clean releases (3.0.0). -->
    <NuspecProperties>version=$(PackageVersion)</NuspecProperties>
  </PropertyGroup>
</Project>