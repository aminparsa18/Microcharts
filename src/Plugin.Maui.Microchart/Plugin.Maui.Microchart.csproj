<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- iOS, Android, MacCatalyst -->
    <TargetFrameworks>net10.0;net10.0-ios;net10.0-maccatalyst;net10.0-android</TargetFrameworks>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseMaui>true</UseMaui>
    <Nullable>disable</Nullable>
    <Description>Simple, cross-platform chart library for .NET MAUI.</Description>
    <PackageTags>maui dotnet chart</PackageTags>
    <RepositoryUrl>https://github.com/aminparsa18/Plugin.Maui.Microchart.git</RepositoryUrl>
    <PackageProjectUrl>https://github.com/aminparsa18/Plugin.Maui.Microchart</PackageProjectUrl>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Plugin.Maui.Microchart.Core\Plugin.Maui.Microchart.Core.csproj" />
  </ItemGroup>
</Project>
